---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main>
			<h1>umablog</h1>
			<p>
				Daily market and business analysis, synthesized every morning from six financial
				media sources: Forbes JAPAN, WSJ, Bloomberg, Reuters/SBI Securities, Minkabu, and
				bitbank.
			</p>
			<p>
				Every post starts from the same question: what's actually connecting today's
				headlines? An automated research agent scans all six sources, looks for stories
				that reinforce or contradict each other across markets, fact-checks the strongest
				thread it finds, and writes up the result — with claims tagged by reliability and
				speculation clearly marked as such. See the <a href="/about">About</a> page for the
				full editorial process.
			</p>
			<p>New analysis publishes every morning. <a href="/blog">Read the latest →</a></p>
		</main>
		<Footer />
	</body>
</html>
